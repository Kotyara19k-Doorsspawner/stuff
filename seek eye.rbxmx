operties><Content name="AnimationId"><url><![CDATA[http://www.roblox.com/asset/?id=507770818]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[LaughAnim]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="StringValue" referent="447"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[mood]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Animation" referent="448"><Properties><Content name="AnimationId"><url><![CDATA[rbxassetid://14366558676 ]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[Animation1]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="StringValue" referent="449"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[point]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Animation" referent="450"><Properties><Content name="AnimationId"><url><![CDATA[http://www.roblox.com/asset/?id=507770453]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[PointAnim]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="StringValue" referent="451"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[run]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Animation" referent="452"><Properties><Content name="AnimationId"><url><![CDATA[http://www.roblox.com/asset/?id=913376220]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[RunAnim]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="StringValue" referent="453"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[sit]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Animation" referent="454"><Properties><Content name="AnimationId"><url><![CDATA[http://www.roblox.com/asset/?id=2506281703]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SitAnim]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="StringValue" referent="455"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[swim]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Animation" referent="456"><Properties><Content name="AnimationId"><url><![CDATA[http://www.roblox.com/asset/?id=913384386]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[Swim]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="StringValue" referent="457"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[swimidle]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Animation" referent="458"><Properties><Content name="AnimationId"><url><![CDATA[http://www.roblox.com/asset/?id=913389285]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SwimIdle]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="StringValue" referent="459"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[toollunge]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Animation" referent="460"><Properties><Content name="AnimationId"><url><![CDATA[http://www.roblox.com/asset/?id=522638767]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[ToolLungeAnim]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="StringValue" referent="461"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[toolnone]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Animation" referent="462"><Properties><Content name="AnimationId"><url><![CDATA[http://www.roblox.com/asset/?id=507768375]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[ToolNoneAnim]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="StringValue" referent="463"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[toolslash]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Animation" referent="464"><Properties><Content name="AnimationId"><url><![CDATA[http://www.roblox.com/asset/?id=522635514]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[ToolSlashAnim]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="StringValue" referent="465"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[walk]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Animation" referent="466"><Properties><Content name="AnimationId"><url><![CDATA[http://www.roblox.com/asset/?id=913402848]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[WalkAnim]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="StringValue" referent="467"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[wave]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Animation" referent="468"><Properties><Content name="AnimationId"><url><![CDATA[http://www.roblox.com/asset/?id=507770239]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[WaveAnim]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="BindableFunction" referent="469"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[PlayEmote]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="Script" referent="470"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

-- [FilteringEnabled] Server Scripts are IMPOSSIBLE to save]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[DanceScript]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="TextBox" referent="471"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Inconsolata.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><bool name="RichText">true</bool><bool name="ShowNativeInput">false</bool><string name="Text"><![CDATA[--DanceScript  -  Make an NPC dance.   ScottSpiritWalker, 12/30/2024.

local Npc = script.Parent
local NpcHumanoid = Npc:WaitForChild("Humanoid")
local NpcAnimator = NpcHumanoid:FindFirstChild("Animator") or NpcHumanoid

local anim = Instance.new("Animation")
anim.AnimationId = "rbxassetid://15609995579"   --15609995579 is Yungblud Happier Jump AnimationId not AssetId.
local loadedAnim = NpcAnimator:LoadAnimation(anim)
loadedAnim.Looped = true
loadedAnim:Play()







