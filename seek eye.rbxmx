universe-places”, then tap “Add API System”.]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">4</int><UDim2 name="Size"><XS>0.949999988079071</XS><XO>0</XO><YS>0.02199999988079071</YS><YO>0</YO></UDim2><int name="ZIndex">7</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[09TextLabel6]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="1733"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Guru.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[7)  Select your starter Experience (like “yourname’s Place”).  Then tap “Add Experience”.]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">4</int><UDim2 name="Size"><XS>0.949999988079071</XS><XO>0</XO><YS>0.02199999988079071</YS><YO>0</YO></UDim2><int name="ZIndex">7</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[10TextLabel7]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="1734"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Guru.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[8)  Select “write” from the “Experience Operations” drop-down list. (Result: "universe-places:write").]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">4</int><UDim2 name="Size"><XS>0.949999988079071</XS><XO>0</XO><YS>0.02199999988079071</YS><YO>0</YO></UDim2><int name="ZIndex">7</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[11TextLabel8]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="1735"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Guru.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><float name="LineHeight">0.8999999761581421</float><string name="Text"><![CDATA[9)  Repeat steps 6 through 8 above except this time in step 6 select API System “universe”.  And, in step 8 choose both "write" operations. (Result: "universe.place:write" and "universe:write"). ]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">4</int><UDim2 name="Position"><XS>0.02499997615814209</XS><XO>0</XO><YS>0.6045570373535156</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.9500000476837158</XS><XO>0</XO><YS>0.0410490483045578</YS><YO>0</YO></UDim2><int name="ZIndex">7</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[12TextLabel9]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="1736"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Guru.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[10)  In “(3) Security” enter “0.0.0.0/0” and tap “Add IP Address”.  ]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">4</int><UDim2 name="Position"><XS>0.025000043213367462</XS><XO>0</XO><YS>0.6328411102294922</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.949999988079071</XS><XO>0</XO><YS>0.02199999988079071</YS><YO>0</YO></UDim2><int name="ZIndex">7</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[13TextLabel10]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="1737"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Guru.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[Be sure to Teleport to your game from Studio Lite’s Published page (in the Splash menu).  Then you can find your game easily in the future in the Roblox “Continue” menu.  While playing your game, be sure to use the Invite feature in the Roblox icon.]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">4</int><UDim2 name="Position"><XS>0.025000005960464478</XS><XO>0</XO><YS>0.4349760115146637</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.949999988079071</XS><XO>0</XO><YS>0.04463415592908859</YS><YO>0</YO></UDim2><int name="ZIndex">7</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[16TextLabel1]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="1738"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Guru.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[Tips:]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">4</int><UDim2 name="Position"><XS>0.025000043213367462</XS><XO>0</XO><YS>0.6328411102294922</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.949999988079071</XS><XO>0</XO><YS>0.02800000086426735</YS><YO>0</YO></UDim2><int name="ZIndex">7</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[15TextLabelTips]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="1739"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Guru.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><float name="LineHeight">0.8999999761581421</float><string name="Text"><![CDATA[11)  Tap “Save & Generate Key”.  The api-key is a long string of letters and numbers.  You must tap “Copy Key To Clipboard”, paste it into Studio Lite’s “Publish” page.  If you lose it, you can “Edit” your key and “regenerate” a new api-key to copy.]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">4</int><UDim2 name="Position"><XS>0.025000043213367462</XS><XO>0</XO><YS>0.8037484288215637</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.9499999284744263</XS><XO>0</XO><YS>0.05853544548153877</YS><YO>0</YO></UDim2><int name="ZIndex">7</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[14TextLabel11]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="1740"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Guru.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><float name="LineHeight">0.8999999761581421</float><string name="Text"><![CDATA[Then tap “☰” near Dashboard and choose “Places”, then tap your place’s icon (you might have to tap it twice) to get to the Basic Settings page.]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">4</int><UDim2 name="Position"><XS>0.025000005960464478</XS><XO>0</XO><YS>0.6197625994682312</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.949999988079071</XS><XO>0</XO><YS>0.03447561338543892</YS><YO>0</YO></UDim2><int name="ZIndex">7</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[18TextLabelTips3]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="1741"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Guru.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><float name="LineHeight">0.8999999761581421</float><string name="Text"><![CDATA[Now you can press “☰” again to see choices for icon, thumbnails, etc.  Game names, descriptions and images are moderated by Roblox, so there might be a delay before they become visible.]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">4</int><UDim2 name="Position"><XS>0.025000005960464478</XS><XO>0</XO><YS>0.6887139081954956</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.949999988079071</XS><XO>0</XO><YS>0.032794516533613205</YS><YO>0</YO></UDim2><int name="ZIndex">7</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[19TextLabelTips4]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="1742"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Guru.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[To update your Experience’s icon and thumbnails use the Roblox Creator Hub:  From the Roblox mobile App, tap “More (…)”, then tap “Create (</>)”.  Then tap on your experience (like “yourname’s Place”) then choose “Manage Experience”.  ]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">4</int><UDim2 name="Position"><XS>0.02499997615814209</XS><XO>0</XO><YS>0.5242443084716797</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.9500000476837158</XS><XO>0</XO><YS>0.047080814838409424</YS><YO>0</YO></UDim2><int name="ZIndex">7</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[17TextLabel2]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="UIPadding" referent="1743"><Properties><UDim name="PaddingTop"><S>0</S><O>7</O></UDim><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="TextLabel" referent="1744"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Guru.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><float name="LineHeight">0.8999999761581421</float><string name="Text"><![CDATA[Changes made in the Roblox Creator Hub will cause your game to be removed from Studio Lite’s Published list.  If you want it back on the list, publish it again.]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 nam