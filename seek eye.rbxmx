-- [FilteringEnabled] Server Scripts are IMPOSSIBLE to save]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[FollowScript]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="TextBox" referent="475"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Inconsolata.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><bool name="RichText">true</bool><bool name="ShowNativeInput">false</bool><string name="Text"><![CDATA[--FollowScript  -  Follow whoever is closest for 5 seconds, then reevaluate who is closest.  ScottSpiritWalker, 12/28/2024.

wait(1)
local NPC = script.Parent
local NPCHrp = NPC:WaitForChild("HumanoidRootPart")
local NPCPos 
local targetPlayer
local targetHrp
local targetPos
local dist = 0
local closestDist = 9999
local counter = 0
NPCHrp.Anchored = false
while true do
	NPCPos = NPCHrp.Position
	if not targetPlayer or not targetPlayer.Parent or not targetPlayer.Character or counter > 10 then
		targetPlayer = nil
		closestDist = 9999
		for _,p in pairs(game.Players:GetPlayers()) do
			if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				dist = (p.Character:FindFirstChild("HumanoidRootPart").Position - NPCPos).magnitude 
				if dist < closestDist then
					closestDist = dist
					targetPlayer = p
					counter = 0
				end
			end
		end
	end
	if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
		targetHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
		if targetHrp then
			targetPos = targetHrp.Position + (targetHrp.CFrame.RightVector * 4)
			dist = (targetPos - NPCPos).magnitude 
			if dist > 7 then
				NPC.Humanoid.WalkToPoint = targetPos
			end
		end
	end
	counter = counter + 1
	wait(.5)
end
]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>1</R><G>0.6666666865348816</G><B>0</B></Color3><token name="BorderMode">2</token><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Position"><XS>0</XS><XO>52</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">4</int><bool name="AutoLocalize">false</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_CodeTextBox]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="LocalScript" referent="476"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

