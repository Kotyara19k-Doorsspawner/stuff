r delete something on the client side.
It is most often used to show or update Guis on the client, but can be used to modify other types of Instances. This localscript is already inserted into StarterPlayer.StarterCharacterScripts.  Find it in the Explorer window on the right and open it for more details.]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><token name="AutomaticSize">2</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><UDim2 name="Position"><XS>0.20000000298023224</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.699999988079071</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">3</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[DesctiptionTextLabel]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="UIPadding" referent="1774"><Properties><UDim name="PaddingLeft"><S>0</S><O>4</O></UDim><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="UITextSizeConstraint" referent="1775"><Properties><int name="MaxTextSize">18</int><int name="MinTextSize">18</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item></Item></Item><Item class="Frame" referent="1776"><Properties><token name="AutomaticSize">2</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="LayoutOrder">4</int><UDim2 name="Size"><XS>1</XS