Pro.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[This localscript is automatically included when you insert the server script: ToolScript.  It remote calls the ToolScript passing the mouse click (or screen tap) position to the ToolScript.  This is handy for tools that shoot at or point at objects in the Workspace.]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><token name="AutomaticSize">2</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><UDim2 name="Position"><XS>0.20000000298023224</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>0.699999988079071</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">3</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[DesctiptionTextLabel]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="UIPadding" referent="1781"><Properties><UDim name="PaddingLeft"><S>0</S><O>4</O></UDim><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="UITextSizeConstraint" referent="1782"><Properties><int name="MaxTextSize">18</int><int name="MinTextSize">18</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="TextLabel" referent="1783"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/SourceSansPro.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="Text"><![