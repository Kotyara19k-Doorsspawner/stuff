y><Weight>700</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[Now you can Rotate the body part, and test it using the Play button (▶) on the left. If you want to Move instead of Rotate, tap the word "Rotate" in the top bar.]]></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">16</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>0.19215688109397888</R><G>0.19215688109397888</G><B>0.19215688109397888</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">1</int><UDim2 name="Position"><XS>0</XS><XO>15</XO><YS>0</YS><YO>20</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-11</XO><YS>0</YS><YO>65</YO></UDim2><int name="ZIndex">6</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[line02]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="765"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/SourceSansPro.json]]></url></Family><Weight>700</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[You can tap or drag keyframes (Kf) to copy or move them. Tap a green pose to copy it. Use the EDIT menu to paste or adjust your animation looping and length.  ]]></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">16</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>0.19215688109397888</R><G>0.19215688109397888</G><B>0.19215688109397888</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">1</int><UDim2 name="Position"><XS>0</XS><XO>15</XO><YS>0</YS><YO>20</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-11</XO><YS>0</YS><YO>65</YO></UDim2><int name="ZIndex">6</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[line03]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="766"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/SourceSansPro.json]]></url></Family><Weight>700</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[    SAVE YOUR WORK:  Tap ANIM, Save to overwrite or create a new KeyframeSequence. You MUST ALSO SAVE YOUR STUDIO LITE GAME!]]></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">16</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>0.27450981736183167</R><G>0.27450981736183167</G><B>0.27450981736183167</B></Color3><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">1</int><UDim2 name="Position"><XS>0</XS><XO>0</XO><YS>0</YS><YO>49</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-11</XO><YS>0</YS><YO>67</YO></UDim2><int name="ZIndex">6</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[line04]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="767"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/SourceSansPro.json]]></url></Family><Weight>700</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[Currently, Roblox security prevents uploading an Animation ID to your account.]]></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">16</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>0.27450981736183167</R><G>0.27450981736183167</G><B>0.27450981736183167</B></Color3><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">1</int><UDim2 name="Position"><XS>0</XS><XO>15</XO><YS>0</YS><YO>20</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-11</XO><YS>0</YS><YO>33</YO></UDim2><int name="ZIndex">6</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[line05]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="768"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/SourceSansPro.json]]></url></Family><Weight>700</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[When you Save your animation, checkmark the "Add Script to rig..." to install the script.]]></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">16</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>0.27450981736183167</R><G>0.27450981736183167</G><B>0.27450981736183167</B></Color3><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">1</int><UDim2 name="Position"><XS>0</XS><XO>15</XO><YS>0</YS><YO>20</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-11</XO><YS>0</YS><YO>33</YO></UDim2><int name="ZIndex">6</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[line07]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="769"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/SourceSansPro.json]]></url></Family><Weight>700</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[To get the animation ID of an Emote, use the Toolbox model importer with the emote's asset id, then look at its properties.]]></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">16</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>0.19215688109397888</R><G>0.19215688109397888</G><B>0.19215688109397888</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">1</int><UDim2 name="Position"><XS>0</XS><XO>15</XO><YS>0</YS><YO>20</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-11</XO><YS>0</YS><YO>50</YO></UDim2><int name="ZIndex">6</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[line12]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="770"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/SourceSansPro.json]]></url></Family><Weight>700</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[You can also find some KeyframeSequences in models at create.roblox.com/models . Search for ANIMSAVES.]]></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">16</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>0.19215688109397888</R><G>0.19215688109397888</G><B>0.19215688109397888</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">1</int><UDim2 name="Position"><XS>0</XS><XO>15</XO><YS>0</YS><YO>20</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-11</XO><YS>0</YS><YO>50</YO></UDim2><int name="ZIndex">6</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[line13]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="771"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/SourceSansPro.json]]></url></Family><Weight>700</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[But, Studio Lite can play KeyframeSequences in Play/test mode and in your Published game using a script called AnimationLitePlayScript.]]></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">16</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>0.27450981736183167</R><G>0.27450981736183167</G><B>0.27450981736183167</B></Color3><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">1</int><UDim2 name="Position"><XS>0</XS><XO>15</XO><YS>0</YS><YO>20</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-11</XO><YS>0</YS><YO>67</YO></UDim2><int name="ZIndex">6</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[line06]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="772"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/SourceSansPro.json]]></url></Family><Weight>700</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[    IMPORT ANIMATIONS:  You can import public animations using Studio Lite's Toolbox Model importer. Just paste the animation ID.]]></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">16</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>0.19215688109397888</R><G>0.19215688109397888</G><B>0.19215688109397888</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">1</int><UDim2 name="Position"><XS>0</XS><XO>15</XO><YS>0</YS><YO>20</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-11</XO><YS>0</YS><YO>50</YO></UDim2><int name="ZIndex">6</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[line11]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="773"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/SourceSansPro.json]]></url></Family><Weight>700</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[Or you can copy the code into a tool equipped or activated script to trigger it.]]></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">16</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>0.27450981736183167</R><G>0.27450981736183167</G><B>0.27450981736183167</B></Color3><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">1</int><UDim2 name="Position"><XS>0</XS><XO>15</XO><YS>0</YS><YO>20</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-11</XO><YS>0</YS><YO>33</YO></UDim2><int name="ZIndex">6</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[line08]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="774"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/SourceSansPro.json]]></url></Family><Weight>700</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[If your animation doesn't blend well with Roblox animations, you can disable Roblox's Animate script in the rig.]]></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">16</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>0.27450981736183167</R><G>0.27450981736183167</G><B>0.27450981736183167</B></Color3><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">1</int><UDim2 name="Position"><XS>0</XS><XO>15</XO><YS>0</YS><YO>20</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-11</XO><YS>0</YS><YO>50</YO></UDim2><int name="ZIndex">6</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[line10]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextLabel" referent="775"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/SourceSansPro.json]]></url></Family><Weight>700</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[The script has comments and examples that can help you stop your animation early, or pause you script until the animation is done.]]></string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="TextSize">16</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><Color3 name="BackgroundColor3"><R>0.27450981736183167</R><G>0.27450981736183167</G><B>0.27450981736183167</B></Color3><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">1</int><UDim2 name="Position"><XS>0</XS><XO>15</XO><YS>0</YS><YO>20</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>-11</XO><YS>0</YS><YO>55</YO></UDim2><int name="ZIndex">6</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[line09]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item></Item></Item></Item><Item class="Frame" referent="776"><Properties><Color3 name="BackgroundColor3"><R>0.9098039269447327</R><G>0.8784313797950745</G><B>0.8784313797950745</B></Color3><Color3 name="BorderColor3"><R>0.5843137502670288</R><G>0.5843137502670288</G><B>0.5843137502670288</B></Color3><UDim2 name="Position"><XS>0</XS><XO>60</XO><YS>0</YS><YO>1</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>0</YS><YO>20</YO></UDim2><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[TopBar]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="TextButton" referent="777"><Properties><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/SourceSansPro.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><string name="Text"><![CDATA[FILE]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><bool name="Modal">true</bool><Color3 name="BackgroundColor3"><R>1</R><G>0.9803921580314636</G><B>0.7176470756530762</B></Color3><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><UDim2 name="Size"><XS>0</XS><XO>57</XO><YS>1</YS><YO>0</YO></UDim2><BinaryString name="AttributesSerialize"></BinaryStri