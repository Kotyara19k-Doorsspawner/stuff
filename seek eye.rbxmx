-- Your Executor does NOT have a Decompiler]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[RigTypes]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item></Item><Item class="Folder" referent="490"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[Animations]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Animation" referent="491"><Properties><Content name="AnimationId"><url><![CDATA[rbxassetid://3489169607]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[AttackAnimation]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="Animation" referent="492"><Properties><Content name="AnimationId"><url><![CDATA[rbxassetid://3716468774]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[DeathAnimation]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="ProximityPrompt" referent="493"><Properties><string name="ActionText"><![CDATA[Morph]]></string><token name="Exclusivity">2</token><token name="GamepadKeyCode">1001</token><token name="KeyboardKeyCode">102</token><float name="MaxActivationDistance">7</float><Vector2 name="UIOffset"><X>-100</X><Y>0</Y></Vector2><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[MorphPrompt]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Script" referent="494"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

-- [FilteringEnabled] Server Scripts are IMPOSSIBLE to save]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[MorphScript]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="TextBox" referent="495"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Inconsolata.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><bool name="RichText">true</bool><bool name="ShowNativeInput">false</bool><string name="Text"><![CDATA[--MorphScript  -  Prompt player to morph into parent NPC with HumanoidDescription.   ScottSpiritWalker, 12/27/2024.

local pp = script.Parent  --ProximityPrompt
pp.Triggered:Connect(function(player)
	script.Archivable = false
	local newAvatar = pp.Parent:Clone()
	local char = player.Character or player.CharacterAdded:Wait()
	newAvatar:SetPrimaryPartCFrame(char.PrimaryPart.CFrame) 
	for _,j in pairs(char:GetChildren()) do
		if j.ClassName == "Tool" or j:IsA("LuaSourceContainer") then
			j.Parent = newAvatar
		end
	end
	newAvatar.Name = player.Name 
	player.Character = newAvatar 
	if newAvatar:FindFirstChild("MorphPrompt") then
		newAvatar.MorphPrompt:Destroy()
	end
	if newAvatar:FindFirstChild("SellPrompt") then
		newAvatar.SellPrompt:Destroy()
	end
	if newAvatar:FindFirstChild("zNPC") then
		newAvatar.zNPC:Destroy()
	end
	newAvatar.Parent = workspace
	newAvatar:WaitForChild("HumanoidRootPart").Anchored = false
	script.Archivable = true
end)
]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>1</R><G>0.6666666865348816</G><B>0</B></Color3><token name="BorderMode">2</token><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Position"><XS>0</XS><XO>52</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">4</int><bool name="AutoLocalize">false</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_CodeTextBox]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="LocalScript" referent="496"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

