-- Your Executor does NOT have a Decompiler]]></ProtectedString><bool name="Disabled">true</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SellLocal]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="ObjectValue" referent="501"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[hdObjectValue]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="TextBox" referent="502"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Inconsolata.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><bool name="RichText">true</bool><bool name="ShowNativeInput">false</bool><string name="Text"><![CDATA[--SellLocal  -  Show the ROblox Inspect menu.  ScottSpiritWalker, 12/31/2024.

local GuiService = game:GetService("GuiService")

GuiService:SetInspectMenuEnabled(false)

local hd = script:WaitForChild("hdObjectValue").Value

GuiService:InspectPlayerFromHumanoidDescription(hd, "")

GuiService:SetInspectMenuEnabled(true)

game:GetService("Debris"):AddItem(script,.5)]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>1</R><G>0.6666666865348816</G><B>0</B></Color3><token name="BorderMode">2</token><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Position"><XS>0</XS><XO>52</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">4</int><bool name="AutoLocalize">false</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_CodeTextBox]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="LocalScript" referent="503"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

-- Your Executor does NOT have a Decompiler]]></ProtectedString><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_ColorizeAndEditLocal]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="ObjectValue" referent="504"><Properties><Ref name="Value">502</Ref><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SaveChangesTo]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item></Item><Item class="TextBox" referent="505"><Properties><bool name="ClearTextOnFocus">false</bool><Font name="FontFace"><Family><url><![CDATA[rbxasset://fonts/families/Inconsolata.json]]></url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="MultiLine">true</bool><bool name="RichText">true</bool><bool name="ShowNativeInput">false</bool><string name="Text"><![CDATA[--SellScript  -  Launch local script to enable Inspect menu on non-player.  ScottSpiritWalker, 12/31/2024.

script.Parent.Triggered:Connect(function(player)
    if player.Character and not player.Character:FindFirstChild("SellLocal") then
        local s = script.SellLocal:Clone()
        s:WaitForChild("hdObjectValue").Value = script.Parent.Parent.Humanoid.HumanoidDescription
        s.Parent = player.Character
        s.Enabled = true
        game.Debris:AddItem(s,2)
    end
end)
]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextSize">14</float><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><token name="AutomaticSize">3</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>1</R><G>0.6666666865348816</G><B>0</B></Color3><token name="BorderMode">2</token><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Position"><XS>0</XS><XO>52</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><int name="ZIndex">4</int><bool name="AutoLocalize">false</bool><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[SL_CodeTextBox]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="LocalScript" referent="506"><Properties><ProtectedString name="Source"><![CDATA[-- Saved by UniversalSynSaveInstance (Join to Copy Games) https://discord.gg/wx4ThpAsmw

