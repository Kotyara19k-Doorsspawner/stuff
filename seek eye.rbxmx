DATA[LocalScripts run on your device and their actions are usually not seen by the server or by other players unless it remote calls a Server Event.  Studio Lite automatically inserts a prewritten LocalScript when you insert a server Script that needs a remote call.  The GuiHideLocal is a handy way to close a Gui when the player is done reading it, if no server interaction is needed.  If the server does need to act on the click, insert the Script (not localscript): GuiActivatedScript.  It will automatically insert a child LocalScript to activate the button.]]></string><Color3 name="TextColor3"><R>0</R><G>0</G><B>0</B></Color3><bool name="TextScaled">true</bool><float name="TextSize">14</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><token name="AutomaticSize">2</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">1</int><UDim2 name="Position"><XS>0</XS><XO>2</XO><YS>0</YS><YO>0</YO></UDim2><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>0</YS><YO>20</YO></UDim2><int name="ZIndex">3</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[TextLabel1]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="UIPadding" referent="1754"><Properties><UDim name="PaddingLeft"><S>0</S><O>4</O></UDim><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="UITextSizeConstraint" referent="1755"><Properties><int name="MaxTextSize">18</int><int name="MinTextSize">18</int><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class=